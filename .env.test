# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Flux GTFS-RT servi par RealtimeFeedMock (client HTTP simulé, framework.yaml).
GTFS_REALTIME_TRIP_UPDATES_URL=https://gtfs-rt.test/trip-updates

###> symfony/panther ###
PANTHER_APP_ENV=test
PANTHER_ERROR_SCREENSHOT_DIR=./var/panther
PANTHER_DEVTOOLS=0
###< symfony/panther ###

# Chrome des tests navigateur : sans bac à sable, qui ne démarre ni en root
# dans le conteneur app ni sur les runners Ubuntu de GitHub (espaces de noms
# restreints par AppArmor), et sans /dev/shm, limité à 64 Mo dans Docker. Il
# ne charge que les pages de l'appli et le widget Turnstile.
PANTHER_NO_SANDBOX=1
PANTHER_CHROME_ARGUMENTS='--disable-dev-shm-usage'
