.git
.gitignore
.env.local
.env.*.local
.env.test.local
.deployed
.DS_Store

# Cache d'outils lancés dans le workspace (la base de Trivy s'écrit dans
# .cache/trivy) : jamais dans l'image, même si elle est construite après leur
# passage.
.cache/

/var/
/vendor/
/node_modules/
/public/build/
/public/bundles/

# compose.yaml et compose.prod.yaml entrent dans l'image : ops/ci-deploy les
# en extrait sur le serveur, avec bin/deploy.
compose*.yaml
!compose.yaml
!compose.prod.yaml
.dockerignore

*.md
.idea/
.vscode/
