#!/bin/sh
# Lance `make check` avant chaque push et le bloque en cas d'échec.
# Activé par `make up` ou `make hooks`. Contournement : git push --no-verify.

# Git passe une ligne par ref : <ref locale> <sha local> <ref distante> <sha distant>.
# Un sha local nul signale une suppression : un push qui ne fait que supprimer
# des refs n'envoie pas de code, il n'y a rien à contrôler.
pushes_code=false
while read -r _ local_sha _ _; do
    case $local_sha in
        *[!0]*) pushes_code=true ;;
    esac
done
if [ "$pushes_code" = false ]; then
    exit 0
fi

if ! docker compose ps --status running --services 2>/dev/null | grep -qx app; then
    echo 'pre-push : conteneurs arrêtés : lance `make up`, ou pousse avec `--no-verify`.' >&2
    exit 1
fi

make check < /dev/null
