{
	frankenphp {
		# Vide en dev (mode classique : le code est relu à chaque requête).
		# La stage prod du Dockerfile y déclare le worker.
		{$FRANKENPHP_CONFIG}
	}
	order php_server before file_server
}

{$SERVER_NAME:localhost} {
	root * /app/public
	encode zstd br gzip

	# Journal d'accès sans données personnelles (docs/exploitation.md, « Logs
	# et erreurs ») : IP tronquées en /24 et /48, aucun en-tête (l'IP du
	# visiteur, derrière cloudflared, n'est que dans Cf-Connecting-Ip), jetons
	# de réinitialisation du mot de passe et d'invitation remplacés (une règle
	# par route à jeton, vérifiée par PersonalDataMaskingTest).
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
				request>headers delete
				request>uri regexp "^/reset-password/reset/[^/?]+" "/reset-password/reset/***"
				request>uri regexp "^/invitation/[^/?]+" "/invitation/***"
				resp_headers delete
			}
		}
	}

	php_server
}
