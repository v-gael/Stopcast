{
	frankenphp {
		# Vide en dev (mode classique : le code est relu à chaque requête).
		# La stage prod du Dockerfile y déclare le worker.
		{$FRANKENPHP_CONFIG}
	}
	order php_server before file_server
}

{$SERVER_NAME:localhost} {
	root * /app/public
	encode zstd br gzip

	log {
		output stdout
		format console
	}

	php_server
}
