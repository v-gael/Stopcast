# Modèle pour l'environnement prod local (make prod-up).
# Copier en .env.prod.local (non versionné) et renseigner les valeurs.

APP_SECRET=            # générer avec : php -r 'echo bin2hex(random_bytes(16));'
POSTGRES_USER=app
POSTGRES_PASSWORD=     # mot de passe fort, propre à cet environnement
POSTGRES_DB=app
POSTGRES_VERSION=16

GTFS_STATIC_FEED_URL=
GTFS_REALTIME_TRIP_UPDATES_URL=
