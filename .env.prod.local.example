# Modèle pour l'environnement prod local (make prod-up).
# Copier en .env.prod.local (non versionné) et renseigner les valeurs.
# Prod réelle (serveur) : emplacement, accès et rotation des secrets dans
# docs/exploitation.md.

APP_SECRET=            # générer avec : php -r 'echo bin2hex(random_bytes(16));'
POSTGRES_USER=app
POSTGRES_PASSWORD=     # mot de passe fort, propre à cet environnement
POSTGRES_DB=app
POSTGRES_VERSION=16

GTFS_STATIC_FEED_URL=
GTFS_REALTIME_TRIP_UPDATES_URL=
# URL de ping du check Healthchecks.io de l'import GTFS nocturne (vide : aucun ping)
HEALTHCHECKS_GTFS_URL=

# Emails (mot de passe oublié, invitations), envoyés par Brevo : voir
# docs/exploitation.md, « Mails ». Les trois variables sont obligatoires.
# null://null : aucun email ne part (prod locale, ou avant le compte Brevo).
# En prod, la clé SMTP de Brevo, caractères spéciaux encodés pour une URL :
# MAILER_DSN=smtp://<login SMTP>:<clé SMTP>@smtp-relay.brevo.com:587
MAILER_DSN=null://null
MAILER_FROM="Stopcast <no-reply@gaelv.com>"
MAILER_REPLY_TO=contact@gaelv.com
# Adresse publique du site (https://domaine), pour les liens des emails envoyés
# hors requête, comme l'avertissement d'inactivité de la purge nocturne. Sans
# valeur, http://localhost.
DEFAULT_URI=

# Suivi des erreurs (docs/exploitation.md, « Logs et erreurs »). DSN du projet
# Sentry, organisation en région UE (hôte en .de.) ; vide : aucun envoi.
SENTRY_DSN=

# Captcha Cloudflare Turnstile de la connexion et de « mot de passe oublié ».
# Valeurs ci-dessous : les clés de test, qui laissent tout passer (prod
# locale). Prod réelle : les clés du widget du domaine (tableau de bord
# Cloudflare) ; bin/smoke-test échoue si la clé de site de test est servie.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Proxys de confiance (IP ou plages CIDR) et hôtes acceptés (expressions
# régulières), séparés par des virgules ; voir docs/developpement.md. Sans
# proxy devant, TRUSTED_PROXIES reste vide. TRUSTED_HOSTS vide accepte tout
# hôte : le renseigner avec le domaine servi, en gardant localhost pour le
# healthcheck. Valeurs du serveur (réseau edge, domaine servi) :
#   TRUSTED_PROXIES=172.30.0.0/24
#   TRUSTED_HOSTS='^(localhost|127\.0\.0\.1|stopcast\.gaelv\.com)$'
TRUSTED_PROXIES=
TRUSTED_HOSTS='^(localhost|127\.0\.0\.1)$'

# Sauvegarde nocturne (service backup, docs/exploitation.md, « Sauvegardes »).
# Sans RESTIC_REPOSITORY, elle est désactivée. Prod :
# s3:https://<account_id>.eu.r2.cloudflarestorage.com/stopcast-backups (bucket en
# juridiction EU, qui ne répond que sur cette adresse) ; prod locale :
# /srv/restic (dépôt de test, volume restic_local).
RESTIC_REPOSITORY=
RESTIC_PASSWORD=       # long et aléatoire ; sans lui, les sauvegardes sont illisibles
AWS_ACCESS_KEY_ID=     # jeton API R2 du bucket (lecture et écriture)
AWS_SECRET_ACCESS_KEY=
HEALTHCHECKS_BACKUP_URL=
