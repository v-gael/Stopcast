#!/bin/sh
# Valide les fichiers Compose : compose.yaml avec chacune de ses surcharges.
# Une combinaison échoue si `docker compose config -q` renvoie une erreur ou
# écrit quoi que ce soit (une variable non définie n'est qu'un avertissement,
# code 0). Valide toutes les combinaisons avant de conclure, sans démarrer de
# conteneur ni demander de démon Docker. Le job `compose` de `ci.yml` l'appelle
# directement, `make check` l'exécute sur l'hôte avant `bin/check`.

cd "$(dirname "$0")/.." || exit 1

# compose.prod.yaml exige l'étiquette de l'image (bin/deploy la fournit) : une
# valeur factice suffit pour valider.
IMAGE_TAG=check
export IMAGE_TAG

status=0

check() {
    name=$1
    shift
    output=$(docker compose -f compose.yaml "$@" config -q 2>&1)
    code=$?
    if [ "$code" -ne 0 ] || [ -n "$output" ]; then
        printf 'Échec : %s (code %s)\n%s\n\n' "$name" "$code" "$output"
        status=1
    else
        echo "OK : $name"
    fi
}

check 'compose.yaml + compose.override.yaml' -f compose.override.yaml
check 'compose.yaml + compose.ci.yaml' -f compose.ci.yaml
check 'compose.yaml + compose.prod.yaml' -f compose.prod.yaml --env-file .env.prod.local.example
check 'compose.yaml + compose.prod.yaml + compose.prod-local.yaml' -f compose.prod.yaml -f compose.prod-local.yaml --env-file .env.prod.local.example

# Le serveur n'a pas les sources : en prod, aucun service ne doit se construire
# (le build de compose.yaml est retiré par compose.prod.yaml). Dans la sortie
# de `config`, les propriétés d'un service sont indentées de 4 espaces.
if docker compose -f compose.yaml -f compose.prod.yaml --env-file .env.prod.local.example config 2>/dev/null | grep -q '^    build:'; then
    printf 'Échec : compose.yaml + compose.prod.yaml construit une image, la prod doit la tirer de GHCR\n\n'
    status=1
else
    echo 'OK : la prod ne construit aucune image'
fi

# Les images tierces de compose.yaml (celles que la prod tire au lieu de les
# construire) sont épinglées par digest : audit.yml scanne exactement ce que
# bin/deploy fait tourner, et Dependabot en propose les nouveaux digests.
third_party=$(docker compose -f compose.yaml config --format json 2>/dev/null | jq -r '.services[] | select(.build == null) | .image')
if [ -z "$third_party" ]; then
    printf 'Échec : aucune image tierce lue dans compose.yaml\n\n'
    status=1
fi
for image in $third_party; do
    case $image in
        *:*@sha256:*) echo "OK : $image épinglée par étiquette et digest" ;;
        *)
            printf 'Échec : %s de compose.yaml n'\''est pas épinglée par étiquette et digest (<image>:<étiquette>@sha256:…)\n\n' "$image"
            status=1
            ;;
    esac
done

# La version majeure de PostgreSQL vit à trois endroits qui doivent concorder :
# l'image de database, serverVersion des DATABASE_URL (Doctrine) et le client
# de l'image applicative (POSTGRES_VERSION du Dockerfile, pour pg_dump).
server=$(sed -n 's/^    image: postgres:\([0-9][0-9]*\)-.*/\1/p' compose.yaml)
urls=$(grep -ho 'serverVersion=[^&]*' compose*.yaml | sed 's/^serverVersion=//' | sort -u)
client=$(sed -n 's/^ARG POSTGRES_VERSION=//p' Dockerfile)
if [ -n "$server" ] && [ "$urls" = "$server" ] && [ "$client" = "$server" ]; then
    echo "OK : PostgreSQL $server partout (image, serverVersion, client du Dockerfile)"
else
    printf 'Échec : versions majeures de PostgreSQL différentes : image de database « %s », serverVersion des DATABASE_URL « %s », POSTGRES_VERSION du Dockerfile « %s »\n\n' "$server" "$(printf '%s' "$urls" | tr '\n' ' ')" "$client"
    status=1
fi

# Une tâche planifiée tourne dans le worker qui consomme son planning :
# realtime-worker pour le planning realtime, worker pour les autres. Sans sa
# variable, elle lit la valeur vide de .env et son ping ne part jamais, sans
# aucune erreur.
service_block() {
    sed -n "/^  $1:/,/^ \{0,2\}[a-z]/p" compose.prod.yaml
}
files=$(grep -rlE "env: 'HEALTHCHECKS_[A-Z0-9_]+'" src)
pings=0
if [ -z "$files" ]; then
    printf 'Échec : aucune variable HEALTHCHECKS_* trouvée dans src\n\n'
    pings=1
fi
for file in $files; do
    if grep -q "schedule: 'realtime'" "$file"; then
        service=realtime-worker
    else
        service=worker
    fi
    block=$(service_block "$service")
    variables=$(grep -hoE "env: 'HEALTHCHECKS_[A-Z0-9_]+'" "$file" | sed "s/env: '//; s/'//" | sort -u)
    for variable in $variables; do
        if ! printf '%s\n' "$block" | grep -Fqx "      $variable: \${$variable:-}"; then
            printf 'Échec : %s de compose.prod.yaml ne reçoit pas %s (%s), son ping ne partirait jamais\n\n' "$service" "$variable" "$file"
            pings=1
        fi
    done
done
if [ "$pings" -eq 0 ]; then
    echo 'OK : chaque worker reçoit les URL de ping de ses tâches planifiées'
else
    status=1
fi

if [ "$status" -eq 0 ]; then
    echo 'Fichiers Compose valides.'
fi

exit "$status"
