#!/bin/sh
# Lance les contrôles de la CI, dans l'ordre, et s'arrête au premier échec.
# Liste des contrôles du code : la CI GitHub l'appelle directement, `make check`
# l'exécute dans le conteneur app. Les fichiers Compose sont validés à part, sur
# l'hôte, par `bin/check-compose` (le conteneur app n'a pas docker). Les lignes
# ::group:: replient chaque contrôle dans les logs GitHub ; ailleurs, elles
# servent de titres.

# Comme la CI : les contrôles tournent en environnement de test, sauf le lint du
# conteneur de prod.
export APP_ENV=test

summary=''

run() {
    name=$1
    shift
    echo "::group::$name"
    start=$(date +%s)
    "$@"
    status=$?
    duration=$(($(date +%s) - start))
    echo '::endgroup::'
    summary="$summary$(printf '  %-20s %4ss' "$name" "$duration")
"
    if [ "$status" -ne 0 ]; then
        printf '\nÉchec : %s (code %s)\n\n%s' "$name" "$status" "$summary"
        exit "$status"
    fi
}

# La config `when@prod` et les bundles chargés en prod seulement (Sentry)
# n'entrent pas dans le conteneur de test. Cache de prod reconstruit : un cache
# antérieur à l'ajout d'un bundle fausse le résultat.
lint_prod_container() {
    rm -rf var/cache/prod
    APP_ENV=prod APP_DEBUG=0 php bin/console lint:container
}

run 'Composer validate' composer validate --strict
run 'Lint YAML' php bin/console lint:yaml config --parse-tags
run 'Lint Twig' php bin/console lint:twig templates
run 'Lint container' php bin/console lint:container
run 'Lint container prod' lint_prod_container
run 'PHP CS Fixer' vendor/bin/php-cs-fixer check --diff
run 'Rector' vendor/bin/rector process --dry-run --no-progress-bar
run 'PHPStan' vendor/bin/phpstan analyse --no-progress
run 'PHPUnit' php bin/phpunit

printf '\nTous les contrôles passent.\n\n%s' "$summary"
