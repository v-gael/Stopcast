#!/bin/sh
# Lance les contrôles de la CI, dans l'ordre, et s'arrête au premier échec.
# Liste des contrôles du code : la CI GitHub l'appelle directement, `make check`
# l'exécute dans le conteneur app. Les fichiers Compose sont validés à part, sur
# l'hôte, par `bin/check-compose` (le conteneur app n'a pas docker). Les lignes
# ::group:: replient chaque contrôle dans les logs GitHub ; ailleurs, elles
# servent de titres.

# Comme la CI : les contrôles tournent en environnement de test, sauf le lint du
# conteneur de prod.
export APP_ENV=test

# Cache de test vidé, comme la CI qui part de zéro : un noyau sans debug
# (ErrorPagesTest) ne recompile pas un conteneur qui nomme un bundle retiré.
rm -rf var/cache/test

summary=''

run() {
    name=$1
    shift
    echo "::group::$name"
    start=$(date +%s)
    "$@"
    status=$?
    duration=$(($(date +%s) - start))
    echo '::endgroup::'
    summary="$summary$(printf '  %-20s %4ss' "$name" "$duration")
"
    if [ "$status" -ne 0 ]; then
        printf '\nÉchec : %s (code %s)\n\n%s' "$name" "$status" "$summary"
        exit "$status"
    fi
}

# Flex resynchronise importmap.php à chaque require ou update : il y ajoute les
# CSS Bootstrap de tom-select et retire declare(strict_types=1).
check_importmap() {
    status=0
    if grep -q 'tom-select/dist/css/tom-select.bootstrap' importmap.php; then
        echo 'importmap.php contient les CSS Bootstrap de tom-select, ajoutées par Flex.'
        status=1
    fi
    if ! grep -q '^declare(strict_types=1);' importmap.php; then
        echo 'importmap.php a perdu declare(strict_types=1), retiré par Flex.'
        status=1
    fi
    if [ "$status" -ne 0 ]; then
        echo "Si le paquet n'apporte pas de JavaScript : git checkout importmap.php (docs/developpement.md, « Mettre à jour les dépendances »)."
    fi
    return "$status"
}

# Pourquoi un lint en prod : docs/developpement.md, « Qualité de code ».
lint_prod_container() {
    rm -rf var/cache/prod
    APP_ENV=prod APP_DEBUG=0 php bin/console lint:container
}

run 'Composer validate' composer validate --strict
run 'Dépendances' vendor/bin/composer-dependency-analyser
run 'Lint doc' bin/check-docs
run 'Importmap' check_importmap
run 'Lint YAML' php bin/console lint:yaml config --parse-tags
run 'Lint Twig' php bin/console lint:twig templates
run 'Lint container' php bin/console lint:container
run 'Lint container prod' lint_prod_container
run 'PHP CS Fixer' vendor/bin/php-cs-fixer check --diff
run 'Rector' vendor/bin/rector process --dry-run --no-progress-bar
run 'PHPStan' vendor/bin/phpstan analyse --no-progress
run 'PHPUnit' php bin/phpunit

printf '\nTous les contrôles passent.\n\n%s' "$summary"
