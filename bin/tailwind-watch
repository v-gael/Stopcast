#!/bin/sh
# Recompile la CSS Tailwind en dev : au démarrage, puis dès que le contenu d'un
# fichier scanné change. Le service tailwind de compose.override.yaml le lance.
#
# Remplace `tailwind:build --watch`. Sur le bind mount de Docker Desktop, son
# watcher manque des modifications faites depuis le Mac : il relit parfois un
# fichier avant la fin de l'écriture, et ne reçoit rien pour un enregistrement
# par renommage (IDE, git checkout). Les classes ajoutées manquaient alors dans
# la CSS, sans erreur. Comparer une empreinte des fichiers chaque seconde ne
# dépend pas des événements, et reste négligeable (une soixantaine de fichiers).

input='assets/styles/app.css'

trap 'exit 0' INT TERM

# Les chemins des directives @source de app.css, relatifs à la racine du projet.
sources() {
    sed -n 's|^@source "\.\./\.\./\(.*\)";$|\1|p' "$input"
}

previous=''
while true; do
    # Un chemin absent (vendor/ pas encore installé) change l'empreinte quand
    # il apparaît : inutile d'en répéter l'erreur chaque seconde.
    # shellcheck disable=SC2046 # une source par mot, sans espace
    current=$(find "$input" $(sources) -type f -exec md5sum {} + 2>/dev/null | md5sum)
    if [ "$current" != "$previous" ]; then
        if php bin/console tailwind:build; then
            previous=$current
        else
            # Dépendances en cours d'installation, ou erreur de syntaxe CSS.
            echo 'Échec de la compilation : nouvel essai dans 5 secondes.'
            sleep 4
        fi
    fi
    sleep 1
done
