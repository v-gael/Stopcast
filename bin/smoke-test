#!/bin/sh
# Vérifie de l'extérieur qu'une instance de Stopcast répond : la page d'accueil
# sert le formulaire de connexion, avec la vraie clé de site Turnstile hors
# localhost (la prod locale garde la clé de test), la page d'affichage refuse un
# rafraîchissement sans cookie d'écran, /health dit que la base répond et
# aucune réponse ne donne la version de PHP (en-tête X-Powered-By).
# Lancé par le job `deploy` de `ci.yml` sur l'URL publique, après bin/deploy ;
# se lance aussi à la main.
#
#   bin/smoke-test https://stopcast.gaelv.com
#   bin/smoke-test http://localhost              # prod locale (make prod-up)
#
# Ils prouvent que le tunnel, Caddy, PHP, le routage et la base répondent
# (/health, le seul à interroger la base). Chaque contrôle est retenté
# (SMOKE_ATTEMPTS fois, SMOKE_DELAY secondes d'écart) pour laisser au tunnel le
# temps de joindre les nouveaux conteneurs. Voir docs/exploitation.md,
# « Déploiement ».

set -eu

usage() {
    echo 'Usage : bin/smoke-test <url>'
}

case ${1:-} in
    -h | --help)
        usage
        exit 0
        ;;
    http://* | https://*) ;;
    '')
        echo "L'URL de l'instance à vérifier est requise." >&2
        usage >&2
        exit 2
        ;;
    *)
        echo "URL invalide : « $1 » (http:// ou https://)." >&2
        usage >&2
        exit 2
        ;;
esac

if [ "$#" -ne 1 ]; then
    usage >&2
    exit 2
fi

base_url=${1%/}
attempts=${SMOKE_ATTEMPTS:-5}
delay=${SMOKE_DELAY:-10}

body=$(mktemp)
trap 'rm -f "$body" "$body.err"' EXIT

failed=0

# check <nom> <chemin> <code attendu> [<texte attendu dans la réponse>] [<texte interdit>]
check() {
    name=$1
    url=$base_url$2
    expected_code=$3
    expected_text=${4:-}
    unexpected_text=${5:-}

    attempt=1
    while :; do
        # Code 000 : pas de réponse HTTP (connexion refusée, DNS, délai) ; le
        # message de curl dit pourquoi.
        code=$(curl --silent --show-error --max-time 10 --output "$body" --write-out '%{http_code}' "$url" 2>"$body.err") || true
        error=$(cat "$body.err")
        rm -f "$body.err"

        if [ "$code" != "$expected_code" ]; then
            reason="code $code reçu, $expected_code attendu${error:+ ($error)}"
        elif [ -n "$expected_text" ] && ! grep -qF -- "$expected_text" "$body"; then
            reason="code $code, mais la réponse ne contient pas « $expected_text »"
        elif [ -n "$unexpected_text" ] && grep -qF -- "$unexpected_text" "$body"; then
            reason="code $code, mais la réponse contient « $unexpected_text »"
        else
            echo "OK : $name (GET $url → $code)"
            return 0
        fi

        if [ "$attempt" -ge "$attempts" ]; then
            echo "Échec : $name (GET $url) : $reason, après $attempts essai(s)." >&2
            failed=1
            return 0
        fi
        echo "Essai $attempt/$attempts raté : $name : $reason. Nouvel essai dans ${delay} s."
        attempt=$((attempt + 1))
        sleep "$delay"
    done
}

# Clé de site de test de Turnstile (.env) : le captcha laisserait tout passer.
turnstile_test_key=1x00000000000000000000AA
case $base_url in
    http://localhost | http://localhost:* | http://127.0.0.1 | http://127.0.0.1:*)
        check "Page d'accueil et formulaire de connexion" / 200 'name="_password"'
        ;;
    *)
        check "Page d'accueil, formulaire de connexion et clé Turnstile de prod" / 200 'name="_password"' "$turnstile_test_key"
        ;;
esac
check "Page d'affichage fermée sans cookie d'écran" '/display?fragment=1' 401
check 'Base de données joignable' /health 200 '"status":"ok"'

# Après les contrôles retentés : le tunnel joint déjà les nouveaux conteneurs.
# L'en-tête X-Powered-By donnerait la version exacte de PHP (expose_php,
# frankenphp/conf.d/20-app.prod.ini). Sans réponse HTTP, le contrôle échoue.
headers=$(curl --silent --show-error --max-time 10 --output /dev/null --dump-header - "$base_url/" 2>&1) || true
if ! printf '%s\n' "$headers" | grep -q '^HTTP/'; then
    echo "Échec : version de PHP masquée (GET $base_url/) : pas de réponse HTTP (${headers:-réponse vide})." >&2
    failed=1
elif printf '%s\n' "$headers" | grep -qi '^x-powered-by:'; then
    echo "Échec : version de PHP masquée (GET $base_url/) : la réponse porte l'en-tête X-Powered-By." >&2
    failed=1
else
    echo "OK : version de PHP masquée (GET $base_url/ sans en-tête X-Powered-By)"
fi

if [ "$failed" -ne 0 ]; then
    echo "Contrôles après déploiement en échec sur $base_url." >&2
    exit 1
fi

echo "Contrôles après déploiement réussis sur $base_url."
