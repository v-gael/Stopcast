{% extends 'layout/space.html.twig' %}

{% block title %}Mon compte · Stopcast{% endblock %}

{% block content %}
    <h1 class="mb-6 text-2xl font-bold text-slate-900">Mon compte</h1>

    <twig:Card class="max-w-md">
        <dl>
            <dt class="text-sm font-medium text-slate-500">Email</dt>
            <dd class="mt-1 text-slate-900">{{ app.user.email }}</dd>
        </dl>

        <div class="mt-6 flex flex-wrap gap-3">
            <twig:Button href="{{ path('app_account_email') }}" variant="secondary">Modifier mon adresse</twig:Button>
            <twig:Button href="{{ path('app_account_password') }}" variant="secondary">Modifier mon mot de passe</twig:Button>
            {# Hors Turbo, pour que le navigateur télécharge le fichier. #}
            <form method="post" action="{{ path('app_account_export') }}" data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token('export-account') }}">
                <twig:Button type="submit" variant="secondary">Télécharger mes données</twig:Button>
            </form>
            <twig:Button href="{{ path('app_account_delete') }}" variant="danger">Supprimer mon compte</twig:Button>
        </div>
    </twig:Card>
{% endblock %}
