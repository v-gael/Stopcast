{% props variant = 'neutral' %}

{% set variants = {
    neutral: 'bg-slate-100 text-slate-700 ring-slate-300',
    success: 'bg-emerald-50 text-emerald-800 ring-emerald-300',
    warning: 'bg-amber-50 text-amber-800 ring-amber-300',
} %}

<span {{ attributes.defaults({class: 'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ' ~ variants[variant]}) }}>
    {%- block content %}{% endblock -%}
</span>
