{# Pages publiques : la vitrine. #}
{% extends 'base.html.twig' %}

{% block body %}
    <div class="flex min-h-screen flex-col">
        <header class="border-b border-slate-200 bg-white">
            <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
                <a href="{{ path('app_home') }}" class="flex items-center gap-2 text-lg font-bold text-slate-900">
                    <span aria-hidden="true">🚏</span> Stopcast
                </a>
                <a href="https://github.com/v-gael/Stopcast" class="text-sm font-medium text-slate-600 hover:text-slate-900">GitHub</a>
            </div>
        </header>

        <main class="flex-1">
            <twig:Flash class="mx-auto max-w-6xl space-y-2 px-4 pt-6 sm:px-6" />
            {% block content %}{% endblock %}
        </main>

        <footer class="border-t border-slate-200 bg-white">
            <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-slate-500 sm:px-6">
                Stopcast, projet open source sous licence MIT.
            </div>
        </footer>
    </div>
{% endblock %}
