{% import 'home/_macros.html.twig' as showcase %}

{# Fiches horaires papier, en désordre derrière le badge du temps réel : du décor. #}
{% set timetables = [
    ['left-3 top-4 w-44 -rotate-6', "Ligne 1 · Horaires d'hiver", ['6:52 7:12 7:32 7:52', '8:12 8:32 8:52 9:22', '9:52 10:22 10:52 *11:22'], '* sauf samedis'],
    ['right-4 top-2 w-40 rotate-3', 'Ligne 12 · Vacances scolaires', ['7:05 7:35 8:05', '8:35 9:05 (a)9:35'], '(a) ne circule pas le 1er mai'],
    ['left-10 bottom-6 w-40 rotate-2', 'Dimanches et fêtes', ['8:47 9:47 10:47', '11:47 12:47 13:47'], 'Service réduit'],
    ['right-8 bottom-10 w-36 -rotate-3', 'Ligne 2 · Été', ['7:18 7:48 8:18', '8:48 9:18 9:48'], 'Du 7/07 au 31/08'],
    ['left-1/3 top-20 w-36 rotate-6', 'Ligne 21 · Période scolaire', ['7:01 7:21 7:41', '— 8:21 8:41'], 'Horaires indicatifs'],
] %}

{# Appareils seuls, sans décor ; l'écran de chacun à son format. #}
{% set devices = [
    ['Un ancien téléphone', 'w-[78%] rounded-[1.1rem] bg-black p-1.5 ring-1 ring-slate-700', 'rounded-[0.7rem]', 'aspect-[19.5/9]'],
    ['Un Raspberry Pi et son petit écran', 'w-[62%] rounded-sm bg-zinc-800 p-1 after:mx-auto after:block after:h-3 after:w-[92%] after:rounded-b-sm after:bg-emerald-800', '', 'aspect-[3/2]'],
    ['Une tablette', 'w-[70%] rounded-2xl bg-slate-800 p-2.5', 'rounded-md', 'aspect-[4/3]'],
    ['Un écran au mur', 'w-[88%] rounded-sm bg-black p-1 ring-1 ring-black', '', 'aspect-video'],
] %}

{% set card = 'flex flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200' %}

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-6 lg:grid-cols-3">
        <article class="{{ card }}">
            <div class="relative min-h-80 flex-1 overflow-hidden rounded-xl bg-gradient-to-br from-stone-100 to-stone-200" aria-hidden="true">
                {% for timetable in timetables %}
                    <div class="showcase-timetable absolute p-2 text-[10px] leading-tight opacity-75 saturate-50 {{ timetable[0] }}">
                        <p class="mb-1 border-b border-[#5b4a2e40] pb-0.5 font-bold tracking-wide uppercase">{{ timetable[1] }}</p>
                        {% for times in timetable[2] %}<p class="tabular-nums">{{ times }}</p>{% endfor %}
                        <p class="mt-1 italic opacity-70">{{ timetable[3] }}</p>
                    </div>
                {% endfor %}
                <div class="absolute inset-0 grid place-items-center">
                    <div class="rounded-xl bg-[#05203c] px-6 py-5 text-white shadow-2xl ring-4 ring-white">
                        <p class="flex items-center gap-2 text-xs font-semibold tracking-wider text-emerald-300 uppercase">
                            <span class="showcase-signal flex items-end gap-0.5"><i></i><i></i><i></i></span> En direct
                        </p>
                        {# Le bus approche : une minute de moins, une fois, 5 s après l'apparition du bloc. #}
                        <p class="mt-1.5 flex items-center gap-3 text-3xl font-bold whitespace-nowrap"
                           data-controller="showcase-countdown" data-showcase-countdown-to-value="Dans 3 min">
                            {{ showcase.line('1', 'bg-[#009DE0] text-white', 'text-lg') }}
                            <span data-showcase-countdown-target="text">Dans 4 min</span>
                        </p>
                    </div>
                </div>
            </div>
            <h2 class="mt-5 text-lg font-semibold text-slate-900">Du vrai temps réel</h2>
            <p class="mt-1 text-slate-600">Fini les fiches horaires et leurs exceptions : seulement le prochain bus, avec son retard ou son avance, tel que le réseau le transmet.</p>
        </article>

        <article class="{{ card }}">
            <div class="flex min-h-80 flex-1 flex-col justify-center gap-4 rounded-xl bg-gradient-to-br from-sky-50 to-indigo-100 p-5"
                 data-controller="showcase-stops">
                <ol class="flex flex-nowrap items-center justify-center gap-1.5 whitespace-nowrap" aria-label="Arrêts de l'écran, dans l'ordre">
                    {% for title in ['BEURNONVILLE', 'Direction travail', '1ER RAM'] %}
                        <li class="flex items-center gap-1.5">
                            {%- if not loop.first %}<span class="text-xs text-indigo-300" aria-hidden="true">→</span>{% endif %}
                            <span class="rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-slate-500 ring-1 ring-indigo-200 transition-colors duration-300 [&.is-shown]:bg-[#05203c] [&.is-shown]:text-white [&.is-shown]:ring-[#05203c]"
                                  data-showcase-stops-target="stop">{{ title }}</span>
                        </li>
                    {% endfor %}
                </ol>
                <div class="mx-auto w-full max-w-xs overflow-hidden rounded-lg shadow-lg" data-showcase-stops-target="frame">{{ showcase.screen() }}</div>
                <div class="mx-auto h-1 w-full max-w-xs overflow-hidden rounded bg-indigo-200" aria-hidden="true">
                    <div class="h-full w-0 bg-indigo-600" data-showcase-stops-target="bar"></div>
                </div>
                <ul class="flex flex-wrap justify-center gap-2 text-xs text-indigo-900">
                    <li class="rounded bg-white/70 px-2 py-1">Un nom à vous : « Direction travail »</li>
                    <li class="rounded bg-white/70 px-2 py-1">Durée d'affichage réglable</li>
                </ul>
            </div>
            <h2 class="mt-5 text-lg font-semibold text-slate-900">Plusieurs arrêts sur un écran</h2>
            <p class="mt-1 text-slate-600">Les deux sens de votre rue, l'arrêt du travail, celui de l'école : l'écran les affiche à tour de rôle.</p>
        </article>

        <article class="{{ card }}">
            <div class="flex min-h-80 flex-1 flex-col" data-controller="showcase-carousel">
                <div class="grid flex-1 rounded-xl bg-slate-100">
                    {% for device in devices %}
                        <div class="col-start-1 row-start-1 flex min-h-72 items-center justify-center transition-opacity duration-500 motion-reduce:transition-none{{ loop.first ? '' : ' opacity-0' }}"
                             data-showcase-carousel-target="item" data-caption="{{ device[0] }}">
                            <div class="shadow-xl {{ device[1] }}">
                                <div class="overflow-hidden {{ device[2] }}">{{ showcase.screen(class: device[3]) }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <p class="mt-4 text-center text-sm font-medium text-slate-700" data-showcase-carousel-target="caption" aria-live="off">{{ devices[0][0] }}</p>
            </div>
            <h2 class="mt-5 text-lg font-semibold text-slate-900">L'écran que vous avez déjà</h2>
            <p class="mt-1 text-slate-600">Téléphone, Raspberry Pi, tablette, écran au mur : un navigateur suffit, rien à télécharger.</p>
        </article>
    </div>
</section>
