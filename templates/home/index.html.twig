{% extends 'layout/public.html.twig' %}

{% block title %}Stopcast · Le panneau de votre arrêt de bus, chez vous{% endblock %}

{# Seule page indexée : pas de noindex. #}
{% block robots %}{% endblock %}

{% block content %}
    <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 lg:grid-cols-2 lg:py-16">
        <div>
            <div class="mb-4 flex flex-wrap gap-2">
                <twig:Badge variant="success">Temps réel</twig:Badge>
                <twig:Badge>Données ouvertes GTFS</twig:Badge>
                <twig:Badge>Open source</twig:Badge>
            </div>
            <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
                Le panneau de votre arrêt de bus, sur un petit écran chez vous
            </h1>
            <p class="mt-4 text-lg text-slate-600">
                Stopcast réplique en temps réel l'affichage du panneau d'un abri de bus sur un petit écran connecté (Raspberry Pi, tablette…), pour l'arrêt de bus de votre choix : savoir d'un coup d'œil, depuis chez soi, quand partir attraper son bus.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
                <twig:Button href="https://github.com/v-gael/Stopcast">Voir le code sur GitHub</twig:Button>
            </div>
        </div>

        <figure class="flex flex-col items-center gap-4 sm:flex-row sm:items-end sm:justify-center">
            <img src="{{ asset('images/demo.gif') }}" width="480" height="320" class="w-full max-w-sm rounded-lg shadow-lg"
                 alt="Page d'affichage : rotation entre les quais Patton, Beurnonville et Champagne, avec leurs prochains passages">
            <img src="{{ asset('images/afficheur-en-situation.jpg') }}" width="600" height="800" loading="lazy" class="w-40 rounded-lg shadow-lg sm:w-44"
                 alt="Photo de l'afficheur en situation : le panneau sur l'écran 3,5 pouces du Raspberry Pi">
            <figcaption class="sr-only">À gauche, la page d'affichage servie par Stopcast. À droite, l'afficheur en situation.</figcaption>
        </figure>
    </section>

    <section class="border-y border-slate-200 bg-white">
        <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
            <h2 class="text-2xl font-bold text-slate-900">Comment ça marche</h2>
            <p class="mt-2 max-w-3xl text-slate-600">
                Stopcast croise les deux flux de données ouvertes publiés par la plupart des réseaux de transport, et reconstitue pour un quai donné ce qu'affiche le vrai panneau.
            </p>
            <ol class="mt-8 grid gap-6 md:grid-cols-3">
                <li>
                    <twig:Card title="1. Référentiel statique" :titleLevel="3" class="h-full">
                        <p class="text-slate-600">Le jeu GTFS du réseau (lignes, arrêts, quais, destinations des trajets) est importé en base à chaque changement d'horaires.</p>
                    </twig:Card>
                </li>
                <li>
                    <twig:Card title="2. Flux temps réel" :titleLevel="3" class="h-full">
                        <p class="text-slate-600">Le flux GTFS-RT donne l'heure attendue de chaque passage. Stopcast le relit toutes les 20 secondes et range les passages par quai, prêts à être affichés.</p>
                    </twig:Card>
                </li>
                <li>
                    <twig:Card title="3. Afficheur" :titleLevel="3" class="h-full">
                        <p class="text-slate-600">Un appareil (Raspberry Pi, tablette…) ouvre la page d'affichage dans un navigateur et la rafraîchit chaque minute, authentifié par le cookie reçu à l'appairage.</p>
                    </twig:Card>
                </li>
            </ol>
        </div>
    </section>
{% endblock %}
