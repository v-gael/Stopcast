{% import 'home/_macros.html.twig' as showcase %}

{#
 # Lignes urbaines principales du réseau TCAT, aux couleurs de son GTFS (relevé
 # du jeu de démo, ShowcaseScreens). Classes écrites en entier pour Tailwind :
 # la CSP refuse les attributs style.
 #}
{% set lines = [
    ['1', 'bg-[#009DE0] text-white'],
    ['2', 'bg-[#E20019] text-white'],
    ['3', 'bg-[#A85F3E] text-white'],
    ['4', 'bg-[#F29400] text-black'],
    ['5', 'bg-[#00509D] text-white'],
    ['6', 'bg-[#009036] text-white'],
    ['7', 'bg-[#919294] text-black'],
    ['8', 'bg-[#A677AE] text-black'],
    ['10', 'bg-[#C9A791] text-black'],
    ['11', 'bg-[#DD007E] text-white'],
    ['12', 'bg-[#9FC104] text-black'],
    ['N', 'bg-[#CDDE8D] text-black'],
] %}

<section class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-14 sm:px-6 lg:grid-cols-[1.1fr_1fr]">
    <div>
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Le panneau de votre arrêt, sur un écran chez vous</h1>
        <p class="mt-5 max-w-xl text-lg text-slate-600">
            Un coup d'œil avant de mettre vos chaussures : vous savez si le bus passe dans 2 minutes ou dans 12. Les passages en temps réel, pas les horaires théoriques.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3 xl:flex-nowrap">
            <twig:Button href="{{ path('app_access_request') }}" class="whitespace-nowrap px-5 py-3 text-base">Demander un accès</twig:Button>
            {# Le logo, entier et sans effet (règles de marque de GitHub), glisse à côté du texte au survol. #}
            <twig:Button href="https://github.com/v-gael/Stopcast" variant="secondary" class="group gap-0 whitespace-nowrap px-5 py-3 text-base">
                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="mr-0 size-5 w-0 shrink-0 opacity-0 transition-all duration-300 group-hover:mr-2 group-hover:w-5 group-hover:opacity-100 group-focus-visible:mr-2 group-focus-visible:w-5 group-focus-visible:opacity-100 motion-reduce:transition-none"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
                Voir le code sur GitHub
            </twig:Button>
            <a href="#comment-ca-marche" data-controller="smooth-scroll" data-action="smooth-scroll#go"
               class="whitespace-nowrap rounded-md px-3 py-3 font-semibold text-slate-700 hover:bg-white">Comment ça marche ↓</a>
        </div>
        <div class="mt-10">
            <p class="text-sm font-medium text-slate-500">Toutes les lignes du réseau TCAT, à Troyes</p>
            <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {% for line in lines %}{{ showcase.line(line[0], line[1]) }}{% endfor %}
                <span class="pl-1 text-sm text-slate-500">…</span>
            </div>
        </div>
    </div>
    <figure class="rounded-2xl bg-zinc-800 p-3 shadow-2xl">
        <div class="overflow-hidden rounded-lg">{{ showcase.screen(lazy: false) }}</div>
        <figcaption class="sr-only">L'écran fait tourner trois arrêts : leurs cinq prochains passages, ou « Pas de passage prévu actuellement ».</figcaption>
    </figure>
</section>
