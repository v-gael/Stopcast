{% extends 'email/base.html.twig' %}

{% block content %}
    <p style="margin: 0 0 16px;">Bonjour,</p>
    <p style="margin: 0 0 16px;">Cette adresse a été indiquée comme nouvelle adresse d'un compte Stopcast. Pour confirmer ce changement, suivez ce lien :</p>
    <p style="margin: 0 0 16px;">
        <a href="{{ link }}" style="display: inline-block; padding: 10px 16px; background-color: #f59e0b; color: #0f172a; font-weight: bold; text-decoration: none; border-radius: 6px;">Confirmer ma nouvelle adresse</a>
    </p>
    <p style="margin: 0 0 16px; font-size: 13px; color: #64748b; word-break: break-all;">{{ link }}</p>
    <p style="margin: 0 0 16px;">Ce lien est valable 1 heure.</p>
    <p style="margin: 0;">Si vous n'avez rien demandé, ignorez ce message : aucun changement ne sera fait.</p>
{% endblock %}
