{% extends 'layout/space.html.twig' %}

{% block title %}Appairer un écran · {{ device.label }} · Stopcast{% endblock %}

{% block content %}
    <h1 class="mb-6 text-2xl font-bold text-slate-900">{{ device.hasPairedScreen ? "Remplacer l'écran" : 'Appairer un écran' }}</h1>

    <twig:Card class="max-w-md">
        <p class="mb-4 text-sm text-slate-700">Ouvrez la page d'affichage sur l'écran : il montre un code, valable une minute. Saisissez-le ici pour qu'il affiche « {{ device.label }} ».</p>

        {% if device.hasPairedScreen %}
            <p class="mb-4 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-slate-800" data-replace-warning>Un écran est déjà appairé à ce dispositif : il sera déconnecté et affichera de nouveau un code d'appairage.</p>
        {% endif %}

        {{ form_start(form) }}
            {{ form_widget(form) }}

            <div class="flex flex-wrap gap-3">
                <twig:Button type="submit">Appairer</twig:Button>
                <twig:Button href="{{ path('app_device_show', {id: device.id}) }}" variant="secondary">Annuler</twig:Button>
            </div>
        {{ form_end(form) }}
    </twig:Card>
{% endblock %}
