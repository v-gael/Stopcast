{% extends 'layout/space.html.twig' %}

{% block title %}{{ device.label }} · Stopcast{% endblock %}

{% block meta %}
    {# Une action qui ramène ici met la page à jour sans la faire remonter. #}
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
{% endblock %}

{% block content %}
    {# L'état du dispositif est dans la colonne « Dispositif », pas en badge à côté du titre. #}
    <h1 class="mb-6 text-2xl font-bold text-slate-900">{{ device.label }}</h1>

    {# Un tiers pour la rotation, deux pour le dispositif : son écran, et à côté ses réglages, à la hauteur de l'écran. #}
    <div class="grid items-start gap-6 lg:grid-cols-3">
        <twig:Card title="Quais">
            {{ include('display_configuration/_rotation.html.twig') }}
        </twig:Card>

        <twig:Card title="Dispositif" class="lg:col-span-2">
            {# Le contenu d'un composant ne voit pas les imports du gabarit. #}
            {% import 'device/_status.html.twig' as status_macros %}
            <div class="flex flex-col gap-6 xl:flex-row">
                <div class="min-w-0 flex-1">
                    {# Toute la rotation, comme l'écran la montre, sur des passages d'exemple. #}
                    {{ include('display/_preview.html.twig', {
                        preview_url: path('app_device_preview', {id: device.id}),
                        preview_title: 'Aperçu de « ' ~ device.label ~ ' »',
                    }, with_context = false) }}
                </div>

                <div class="flex shrink-0 flex-col justify-between gap-4 xl:w-56">
                    <dl class="space-y-2 text-sm">
                        {# L'état, et la date de création au survol (et pour les lecteurs d'écran). Ce qui l'explique est dans les lignes suivantes et dans la colonne « Quais ». #}
                        {% set created = 'Créé le ' ~ device.createdAt|date('d/m/Y à H:i') %}
                        <div>
                            <dt class="font-medium text-slate-500">État</dt>
                            <dd class="mt-0.5">
                                <span class="inline-flex cursor-help" title="{{ created }}" data-device-state>
                                    {{ status_macros.status(device) }}<span class="sr-only">, {{ created|lower }}</span>
                                </span>
                            </dd>
                        </div>
                        <div>
                            <dt class="font-medium text-slate-500">Écran</dt>
                            <dd class="mt-0.5 text-slate-900" data-screen-state>{{ device.hasPairedScreen ? 'Écran appairé' : 'Aucun écran appairé' }}</dd>
                        </div>
                        <div>
                            <dt class="font-medium text-slate-500">Dernier contact</dt>
                            <dd class="mt-0.5 text-slate-900" data-last-seen>{{ status_macros.last_seen(device) }}</dd>
                        </div>
                        <div>
                            <dt class="font-medium text-slate-500">Durée d'affichage d'un écran</dt>
                            <dd class="mt-0.5 text-slate-900" data-screen-duration>{{ device.screenDuration }} s</dd>
                        </div>
                        <div>
                            <dt class="font-medium text-slate-500">Rafraîchissement des données</dt>
                            <dd class="mt-0.5 text-slate-900" data-refresh-interval>{{ device.refreshInterval }} s</dd>
                        </div>
                    </dl>

                    <div class="flex flex-col gap-2">
                        <twig:Button href="{{ path('app_device_pair', {id: device.id}) }}" variant="secondary">{{ device.hasPairedScreen ? "Remplacer l'écran" : 'Appairer un écran' }}</twig:Button>

                        {% if device.hasPairedScreen %}
                            <form method="post" action="{{ path('app_device_unpair', {id: device.id}) }}"
                                  data-turbo-confirm="Dissocier l'écran de « {{ device.label }} » ? Il affichera de nouveau un code d'appairage.">
                                <input type="hidden" name="_token" value="{{ csrf_token('unpair-device-' ~ device.id) }}">
                                <twig:Button type="submit" variant="secondary" class="w-full">Dissocier</twig:Button>
                            </form>
                        {% endif %}

                        <twig:Button href="{{ path('app_device_edit', {id: device.id}) }}" variant="secondary">Modifier</twig:Button>

                        <form method="post" action="{{ path('app_device_delete', {id: device.id}) }}"
                              data-turbo-confirm="Supprimer « {{ device.label }} » et ses quais ? Cette action est définitive.">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-device-' ~ device.id) }}">
                            <twig:Button type="submit" variant="danger" class="w-full">Supprimer</twig:Button>
                        </form>
                    </div>
                </div>
            </div>
        </twig:Card>
    </div>
{% endblock %}
