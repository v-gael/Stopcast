{% extends 'layout/space.html.twig' %}

{% block title %}Ajouter une configuration d'affichage · Stopcast{% endblock %}

{% block content %}
    <h1 class="mb-6 text-2xl font-bold text-slate-900">Ajouter une configuration d'affichage</h1>

    <twig:Card class="max-w-xl">
        {{ form_start(form) }}
            {{ form_widget(form) }}

            <div class="flex flex-wrap gap-3">
                <twig:Button type="submit">Créer</twig:Button>
                {# Vers le dispositif présélectionné (?device={id}), sinon vers la liste des dispositifs. #}
                {% set device_id = form.device.vars.value %}
                <twig:Button href="{{ device_id ? path('app_device_show', {id: device_id}) : path('app_device_index') }}" variant="secondary">Annuler</twig:Button>
            </div>
        {{ form_end(form) }}
    </twig:Card>
{% endblock %}
