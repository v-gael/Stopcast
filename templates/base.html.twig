<!DOCTYPE html>
<html lang="fr" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Stopcast{% endblock %}</title>
        <meta name="description" content="{% block description %}Les prochains passages de votre arrêt de bus, en temps réel, sur un petit écran chez vous.{% endblock %}">
        {# Nonce de la CSP, lu par Turbo pour sa barre de progression et les scripts qu'il réexécute. #}
        <meta name="csp-nonce" content="{{ csp_nonce('style') }}">
        {% block meta %}{% endblock %}
        {# Seule l'accueil est indexée : robots.txt n'empêche pas l'indexation d'une URL qui reçoit un lien. #}
        {% block robots %}<meta name="robots" content="noindex">{% endblock %}
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Stopcast">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('description') }}">
        <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.baseUrl ~ app.request.pathInfo }}">
        <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app', {nonce: csp_nonce('script')}) }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="{% block body_class %}min-h-full bg-slate-50 text-slate-800 antialiased{% endblock %}">
        {# Premier élément atteint au clavier : saute l'en-tête et la navigation. #}
        <a href="#contenu" class="sr-only rounded-md bg-white px-4 py-2 text-sm font-semibold text-slate-900 shadow-lg focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50">Aller au contenu</a>
        {% block body %}{% endblock %}
    </body>
</html>
