{% extends 'layout/space.html.twig' %}

{% block title %}Modifier {{ user.email }} · Abribus{% endblock %}

{% block content %}
    <h1 class="text-2xl font-bold text-slate-900">Modifier le compte</h1>
    <p class="mb-6 text-slate-600">{{ user.email }}</p>

    <twig:Card class="max-w-md">
        {{ form_start(form) }}
            {{ form_widget(form) }}

            <div class="flex flex-wrap gap-3">
                <twig:Button type="submit">Enregistrer</twig:Button>
                <twig:Button href="{{ path('app_admin_user_index') }}" variant="secondary">Annuler</twig:Button>
            </div>
        {{ form_end(form) }}
    </twig:Card>
{% endblock %}
