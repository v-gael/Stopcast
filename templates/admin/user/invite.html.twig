{% extends 'layout/space.html.twig' %}

{% block title %}Inviter un compte · Abribus{% endblock %}

{% block content %}
    <h1 class="mb-6 text-2xl font-bold text-slate-900">Inviter un compte</h1>

    <twig:Card class="max-w-md">
        {{ form_start(form) }}
            {{ form_widget(form) }}

            <div class="flex flex-wrap gap-3">
                <twig:Button type="submit">Envoyer l'invitation</twig:Button>
                <twig:Button href="{{ path('app_admin_user_index') }}" variant="secondary">Annuler</twig:Button>
            </div>
        {{ form_end(form) }}
    </twig:Card>
{% endblock %}
