{% extends 'layout/space.html.twig' %}

{% block title %}Utilisateurs · Abribus{% endblock %}

{% block content %}
    <h1 class="mb-6 text-2xl font-bold text-slate-900">Utilisateurs</h1>

    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50 text-left font-semibold text-slate-700">
                <tr>
                    <th scope="col" class="px-4 py-3">Email</th>
                    <th scope="col" class="px-4 py-3">Rôle</th>
                    <th scope="col" class="px-4 py-3">Dispositifs</th>
                    <th scope="col" class="px-4 py-3">Créé le</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                {% for row in rows %}
                    {% set user = row.user %}
                    <tr>
                        <td class="px-4 py-3 text-slate-900">
                            {%- if user.id == app.user.id -%}
                                <strong>{{ user.email }}</strong> <span class="text-slate-500">(vous)</span>
                            {%- else -%}
                                {{ user.email }}
                            {%- endif -%}
                        </td>
                        <td class="px-4 py-3"><twig:Badge>{{ user.admin ? 'Administrateur' : 'Utilisateur' }}</twig:Badge></td>
                        <td class="px-4 py-3 text-slate-600">{{ row.deviceCount }}</td>
                        <td class="px-4 py-3 text-slate-600">{{ user.createdAt|date('d/m/Y') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
