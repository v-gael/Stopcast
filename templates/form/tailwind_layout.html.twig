{% extends 'tailwind_2_layout.html.twig' %}

{%- block form_row -%}
    {%- set row_class = row_class|default('mb-5') -%}
    {{- parent() -}}
{%- endblock form_row -%}

{%- block checkbox_row -%}
    {%- set row_class = row_class|default('mb-5') -%}
    {{- parent() -}}
{%- endblock checkbox_row -%}

{%- block widget_attributes -%}
    {%- set widget_class = widget_class|default('mt-1 block w-full rounded-md border-slate-500 shadow-sm focus:border-amber-700 focus:ring-amber-700 sm:text-sm') -%}
    {%- set widget_disabled_class = widget_disabled_class|default('bg-slate-100 text-slate-500') -%}
    {%- set widget_errors_class = widget_errors_class|default('border-red-600 focus:border-red-600 focus:ring-red-600') -%}
    {#- form_row relie déjà l'aide et les erreurs ; checkbox_row ne relie que l'aide : compléter sans doublon. -#}
    {%- if errors|length > 0 -%}
        {%- set described_by = attr['aria-describedby'] is defined ? attr['aria-describedby']|split(' ') : [] -%}
        {%- for index in 1..errors|length -%}
            {%- if (id ~ '_error' ~ index) not in described_by -%}
                {%- set described_by = described_by|merge([id ~ '_error' ~ index]) -%}
            {%- endif -%}
        {%- endfor -%}
        {%- set attr = attr|merge({'aria-invalid': 'true', 'aria-describedby': described_by|join(' ')}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}

{%- block checkbox_widget -%}
    {%- set widget_class = widget_class|default('mr-2 rounded border-slate-500 text-amber-600 focus:ring-amber-700') -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{# Case à cocher dessinée en interrupteur (option « block_prefix: switch ») : vert, cochée ; gris, décochée. #}
{%- block switch_widget -%}
    {%- set widget_class = 'mr-3 relative h-5 w-9 shrink-0 cursor-pointer appearance-none rounded-full border-0 bg-slate-100 ring-1 ring-inset ring-slate-500 transition-colors before:absolute before:top-0.5 before:left-0.5 before:size-4 before:rounded-full before:bg-slate-500 before:shadow before:transition-all checked:bg-emerald-600 checked:bg-none checked:text-emerald-600 checked:ring-0 checked:before:left-[18px] checked:before:bg-white checked:hover:bg-emerald-700 focus:ring-offset-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700' -%}
    {%- set attr = attr|merge({role: 'switch'}) -%}
    {{- block('checkbox_widget') -}}
{%- endblock switch_widget -%}

{# Durée au curseur (SecondsSliderType) : la valeur en gros à droite du libellé, les bornes sous le curseur. #}
{%- block seconds_slider_row -%}
    <div class="mb-5" data-controller="seconds-slider">
        <div class="flex items-baseline justify-between gap-3">
            {{- form_label(form) -}}
            <output for="{{ id }}" class="text-lg font-bold text-slate-900 tabular-nums" data-seconds-slider-target="output">{{ value }} s</output>
        </div>
        {{- form_errors(form) -}}
        {{- form_widget(form) -}}
        <div class="flex justify-between text-xs text-slate-500" aria-hidden="true">
            <span>{{ attr.min }} s</span>
            <span>{{ attr.max }} s</span>
        </div>
        {{- form_help(form) -}}
    </div>
{%- endblock seconds_slider_row -%}

{%- block seconds_slider_widget -%}
    {%- set type = 'range' -%}
    {%- set widget_class = 'mt-2 block w-full cursor-pointer accent-amber-600' -%}
    {%- set attr = attr|merge({
        'data-seconds-slider-target': 'input',
        'data-action': (attr['data-action'] ?? '') ~ ' input->seconds-slider#update',
        'aria-valuetext': value ~ ' secondes',
    }) -%}
    {{- block('form_widget_simple') -}}
{%- endblock seconds_slider_widget -%}

{#
 # Durée parmi des valeurs préréglées (SecondsPresetsType) : des boutons accolés et « Autre », qui montre
 # le champ nombre. Le groupe de boutons n'apparaît qu'avec JavaScript ; sans lui, seul le champ s'affiche.
 #}
{%- block seconds_presets_row -%}
    {%- set segment = 'px-3 py-1.5 text-sm font-semibold ring-1 ring-inset ring-slate-300 -ml-px first:ml-0 first:rounded-l-md last:rounded-r-md focus-visible:z-20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700 aria-pressed:relative aria-pressed:z-10 aria-pressed:bg-slate-900 aria-pressed:text-white aria-pressed:ring-slate-900 not-aria-pressed:bg-white not-aria-pressed:text-slate-700 not-aria-pressed:hover:bg-slate-50' -%}
    <div class="mb-5" data-controller="seconds-presets">
        {{- form_label(form, null, {label_attr: {id: id ~ '_label'}}) -}}
        {{- form_errors(form) -}}
        <div class="mt-1 flex flex-wrap" role="group" aria-labelledby="{{ id }}_label" data-seconds-presets-target="group" hidden>
            {%- for seconds in presets -%}
                <button type="button" class="{{ segment }}" aria-pressed="false" data-seconds-presets-target="preset" data-value="{{ seconds }}" data-action="seconds-presets#choose">
                    {{- seconds < 60 ? seconds ~ ' s' : (seconds // 60) ~ ' min' ~ (seconds % 60 ? ' ' ~ (seconds % 60) ~ ' s' : '') -}}
                </button>
            {%- endfor -%}
            <button type="button" class="{{ segment }}" aria-pressed="false" data-seconds-presets-target="other" data-action="seconds-presets#other">Autre</button>
        </div>
        {{- form_widget(form, {attr: attr|merge({
            'data-seconds-presets-target': 'input',
            'data-action': (attr['data-action'] ?? '') ~ ' input->seconds-presets#sync',
        })}) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock seconds_presets_row -%}

{%- block radio_widget -%}
    {%- set widget_class = widget_class|default('mr-2 border-slate-500 text-amber-600 focus:ring-amber-700') -%}
    {{- parent() -}}
{%- endblock radio_widget -%}

{# Un groupe de cases ou de boutons radio est nommé par le libellé du champ, qui n'a pas de « for ». #}
{%- block choice_widget_expanded -%}
    {%- set attr = attr|merge({role: multiple ? 'group' : 'radiogroup'}|merge(label is same as(false) ? {} : {'aria-labelledby': id ~ '_label'})) -%}
    {{- parent() -}}
{%- endblock choice_widget_expanded -%}

{%- block form_label -%}
    {%- set label_class = label_class|default('block text-sm font-medium text-slate-800') -%}
    {%- if compound and expanded|default(false) -%}
        {%- set label_attr = label_attr|merge({id: id ~ '_label'}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_help -%}
    {%- set help_class = help_class|default('mt-1 text-sm text-slate-500') -%}
    {{- parent() -}}
{%- endblock form_help -%}

{# Erreurs d'un champ sous son libellé, erreurs globales du formulaire dans un encadré. #}
{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        {%- if compound and form.parent is null -%}
            <div class="mb-5 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert">
                <ul class="space-y-1">
                    {%- for error in errors -%}
                        <li>{{ error.message }}</li>
                    {%- endfor -%}
                </ul>
            </div>
        {%- else -%}
            <ul class="mt-1 space-y-1">
                {%- for error in errors -%}
                    <li class="text-sm font-medium text-red-700" id="{{ id ~ '_error' ~ loop.index }}">
                        {{- error.message -}}
                        {%- if error.cause.code|default(null) == constant('Symfony\\Component\\Validator\\Constraints\\NotCompromisedPassword::COMPROMISED_PASSWORD_ERROR') %}
                            <a href="https://haveibeenpwned.com/Passwords" target="_blank" rel="noopener noreferrer" hreflang="en" class="underline">Comment fonctionne cette vérification ?</a>
                        {%- endif -%}
                    </li>
                {%- endfor -%}
            </ul>
        {%- endif -%}
    {%- endif -%}
{%- endblock form_errors -%}
