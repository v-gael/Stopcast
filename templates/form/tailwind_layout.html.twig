{% extends 'tailwind_2_layout.html.twig' %}

{%- block form_row -%}
    {%- set row_class = row_class|default('mb-5') -%}
    {{- parent() -}}
{%- endblock form_row -%}

{%- block checkbox_row -%}
    {%- set row_class = row_class|default('mb-5') -%}
    {{- parent() -}}
{%- endblock checkbox_row -%}

{%- block widget_attributes -%}
    {%- set widget_class = widget_class|default('mt-1 block w-full rounded-md border-slate-500 shadow-sm focus:border-amber-700 focus:ring-amber-700 sm:text-sm') -%}
    {%- set widget_disabled_class = widget_disabled_class|default('bg-slate-100 text-slate-500') -%}
    {%- set widget_errors_class = widget_errors_class|default('border-red-600 focus:border-red-600 focus:ring-red-600') -%}
    {#- form_row relie déjà l'aide et les erreurs ; checkbox_row ne relie que l'aide : compléter sans doublon. -#}
    {%- if errors|length > 0 -%}
        {%- set described_by = attr['aria-describedby'] is defined ? attr['aria-describedby']|split(' ') : [] -%}
        {%- for index in 1..errors|length -%}
            {%- if (id ~ '_error' ~ index) not in described_by -%}
                {%- set described_by = described_by|merge([id ~ '_error' ~ index]) -%}
            {%- endif -%}
        {%- endfor -%}
        {%- set attr = attr|merge({'aria-invalid': 'true', 'aria-describedby': described_by|join(' ')}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}

{%- block checkbox_widget -%}
    {%- set widget_class = widget_class|default('mr-2 rounded border-slate-500 text-amber-600 focus:ring-amber-700') -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{# Case à cocher dessinée en interrupteur (option « block_prefix: switch ») : vert, cochée ; gris, décochée. #}
{%- block switch_widget -%}
    {%- set widget_class = 'mr-3 relative h-5 w-9 shrink-0 cursor-pointer appearance-none rounded-full border-0 bg-slate-100 ring-1 ring-inset ring-slate-500 transition-colors before:absolute before:top-0.5 before:left-0.5 before:size-4 before:rounded-full before:bg-slate-500 before:shadow before:transition-all checked:bg-emerald-600 checked:bg-none checked:text-emerald-600 checked:ring-0 checked:before:left-[18px] checked:before:bg-white checked:hover:bg-emerald-700 focus:ring-offset-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700' -%}
    {%- set attr = attr|merge({role: 'switch'}) -%}
    {{- block('checkbox_widget') -}}
{%- endblock switch_widget -%}

{%- block radio_widget -%}
    {%- set widget_class = widget_class|default('mr-2 border-slate-500 text-amber-600 focus:ring-amber-700') -%}
    {{- parent() -}}
{%- endblock radio_widget -%}

{# Un groupe de cases ou de boutons radio est nommé par le libellé du champ, qui n'a pas de « for ». #}
{%- block choice_widget_expanded -%}
    {%- set attr = attr|merge({role: multiple ? 'group' : 'radiogroup'}|merge(label is same as(false) ? {} : {'aria-labelledby': id ~ '_label'})) -%}
    {{- parent() -}}
{%- endblock choice_widget_expanded -%}

{%- block form_label -%}
    {%- set label_class = label_class|default('block text-sm font-medium text-slate-800') -%}
    {%- if compound and expanded|default(false) -%}
        {%- set label_attr = label_attr|merge({id: id ~ '_label'}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_help -%}
    {%- set help_class = help_class|default('mt-1 text-sm text-slate-500') -%}
    {{- parent() -}}
{%- endblock form_help -%}

{# Erreurs d'un champ sous son libellé, erreurs globales du formulaire dans un encadré. #}
{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        {%- if compound and form.parent is null -%}
            <div class="mb-5 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert">
                <ul class="space-y-1">
                    {%- for error in errors -%}
                        <li>{{ error.message }}</li>
                    {%- endfor -%}
                </ul>
            </div>
        {%- else -%}
            <ul class="mt-1 space-y-1">
                {%- for error in errors -%}
                    <li class="text-sm font-medium text-red-700" id="{{ id ~ '_error' ~ loop.index }}">{{ error.message }}</li>
                {%- endfor -%}
            </ul>
        {%- endif -%}
    {%- endif -%}
{%- endblock form_errors -%}
