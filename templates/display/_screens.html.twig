{#
 # Écrans d'un dispositif, un seul visible à la fois, et ses cadences (en
 # secondes), relues à chaque rafraîchissement. Rendu seul, c'est le fragment
 # que la page relit. « state_message » remplace les écrans par un écran
 # d'état (dispositif désactivé, passages illisibles) ; « offline » lui donne
 # le pictogramme no_signal.
 #
 # Chaque écran porte ses trois états : passages, « aucun passage » et
 # « indisponible ». Le contrôleur Stimulus retire les passages passés et
 # choisit l'état montré (voir display_controller.js).
 #}
{% set no_signal %}
    <img class="screen__no-signal" src="{{ asset('images/display/no_signal.png') }}" alt="Données non rafraîchies">
{% endset %}
{% set unavailable %}
    <img class="screen__unavailable" src="{{ asset('images/display/no_signal.png') }}" alt="">
    <p>Horaires temps réel indisponibles</p>
{% endset %}
{% set clock %}
    <span class="screen__clock" data-display-target="clock">{{ 'now'|date('H:i') }}</span>
{% endset %}
{% set columns %}
    <div class="screen__columns">
        <span>N° ligne</span>
        <span>Dans</span>
        <span>Direction</span>
        {{ no_signal }}
    </div>
{% endset %}
<div class="display-content"
     data-display-target="content"
     data-screen-duration="{{ device.screenDuration }}"
     data-refresh-interval="{{ device.refreshInterval }}">
    {% for screen in state_message is defined and state_message is not null ? [] : screens %}
        <section class="screen" data-display-target="screen"{% if not loop.first %} hidden{% endif %}>
            <div class="screen__top">
                <h1 class="screen__stop">{{ screen.quayName }}</h1>
                {{ clock }}
            </div>
            {{ columns }}
            <div class="screen__message screen__message--icon" data-display-target="noPassage"{% if screen.passages is not empty %} hidden{% endif %}>
                <img class="screen__no-bus" src="{{ asset('images/display/no_bus.png') }}" alt="">
                <p>Pas de passage prévu actuellement</p>
            </div>
            <div class="screen__message screen__message--icon" data-display-target="unavailable" hidden>
                {{ unavailable }}
            </div>
            {% if screen.passages is not empty %}
                <ol class="screen__passages" data-display-target="passages">
                    {% for passage in screen.passages %}
                        <li class="passage" data-display-target="passage" data-expected-at="{{ passage.expectedAt.timestamp }}">
                            <span class="passage__route" data-display-target="route"
                                  {%- if passage.routeColor %} data-route-color="#{{ passage.routeColor }}"{% endif %}
                                  {%- if passage.routeTextColor %} data-route-text-color="#{{ passage.routeTextColor }}"{% endif %}>{{ passage.routeShortName }}</span>
                            <span class="passage__minutes"><span data-display-target="minutes">{{ passage.minutes }}</span> min</span>
                            <span class="passage__headsign">{{ passage.headsign }}</span>
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
        </section>
    {% else %}
        <section class="screen" data-display-target="screen">
            <div class="screen__top">
                <span class="screen__stop"></span>
                {{ clock }}
            </div>
            {{ columns }}
            {% if offline|default(false) %}
                <div class="screen__message screen__message--icon">
                    {{ unavailable }}
                </div>
            {% else %}
                <div class="screen__message">
                    <p>{{ state_message ?? 'Aucun quai affiché' }}</p>
                </div>
            {% endif %}
        </section>
    {% endfor %}
</div>
