{#
 # Contenu de l'écran d'appairage, relu à chaque interrogation : le QR code et
 # le code, les secondes qui lui restent et sa durée d'affichage, ou l'attente
 # quand trop de codes ont été demandés depuis cette adresse. Le temps restant
 # est relatif : le compte à rebours ne dépend pas de l'horloge de l'écran.
 #}
<div class="pairing" data-pairing-target="content"
     {%- if code %} data-code="{{ code }}" data-remaining-seconds="{{ remaining_seconds }}" data-duration-seconds="{{ constant('App\\Display\\Pairing\\ScreenPairing::CODE_DISPLAY_SECONDS') }}"{% endif %}>
    {% if code %}
        <div class="pairing__code-column">
            {# Le SVG est produit par QrCodeSvg à partir de l'URL du parcours d'appairage. #}
            <div class="pairing__qr" role="img" aria-label="QR code vers {{ pairing_url }}">{{ qr_code|raw }}</div>
            <p class="pairing__code">{{ code }}</p>
        </div>
        <div class="pairing__countdown" data-pairing-target="countdown" role="img" aria-label="Temps restant avant un nouveau code"></div>
        <p class="pairing__instruction">Scannez le QR code ou saisissez le code sur {{ host }} → Dispositifs</p>
    {% else %}
        <p class="pairing__message">Trop de demandes, nouvel essai dans quelques minutes</p>
    {% endif %}
</div>
