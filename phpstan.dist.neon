parameters:
    level: 10
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # Fichiers générés et maintenus par les recipes Symfony Flex : on laisse leur contenu tel que fourni, sans y appliquer nos propres règles de qualité
        - tests/bootstrap.php
        - public/index.php
    tmpDir: var/cache/phpstan
    # Appels de débogage : jamais dans le code commité (voir docs/developpement.md).
    disallowedFunctionCalls:
        -
            function:
                - 'dd()'
                - 'debug_zval_dump()'
                - 'dump()'
                - 'phpinfo()'
                - 'print_r()'
                - 'var_dump()'
                - 'var_export()'
            message: 'appel de débogage oublié'
